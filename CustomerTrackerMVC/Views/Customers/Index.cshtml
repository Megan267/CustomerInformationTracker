@model CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
    ViewData["Tab"] = "Customer list";

    var query = Model.Query;
    var result = Model.Result;

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="list-page">
    <div class="page-header">
        <div>
            <h1>Customers</h1>
            <p>Every customer on record. Filter by name or VAT number, click a column heading to sort, and use the actions on each row to edit or delete.</p>
        </div>
        <a class="btn-primary" asp-action="Manage" asp-route-returnUrl="@returnUrl" data-return-link>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            Add customer
        </a>
    </div>

    <partial name="_StatusMessages" />

    @if (ViewData["ApiError"] is string apiError)
    {
        <div class="notice notice-error" role="alert">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v4M12 16h.01" /></svg>
            <span class="notice-text">@apiError</span>
        </div>
    }

    <section class="card table-card">
        <div class="card-head">
            <span class="card-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
                Customer records
            </span>
            <span class="count-pill" data-count-pill>@Model.CountText</span>
        </div>

        <form class="filter-bar" method="get" asp-action="Index" role="search" data-live-filter>
            <input type="hidden" name="sort" value="@query.Sort" />
            @if (query.Desc)
            {
                <input type="hidden" name="desc" value="true" />
            }

            <label class="search-wrap" title="Filter by name">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <span class="visually-hidden">Name</span>
                <input class="search-input" type="search" name="name" value="@query.Name" placeholder="Filter by name" autocomplete="off" maxlength="100" />
            </label>

            <label class="search-wrap" title="Filter by VAT number">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
                <span class="visually-hidden">VAT number</span>
                <input class="search-input" type="search" name="vat" value="@query.Vat" placeholder="Filter by VAT number" autocomplete="off" maxlength="20" />
            </label>

            <button type="submit" class="btn-quiet filter-submit">Apply filters</button>
            <a class="icon-btn" asp-action="Index" asp-route-sort="@query.Sort" asp-route-desc="@(query.Desc ? "true" : null)"
               data-filter-clear hidden="@(!query.HasFilter)">Clear</a>
            <span class="filter-status" data-filter-status aria-live="polite"></span>
        </form>

        <partial name="_CustomerResults" model="Model" />
    </section>
</div>

<div class="modal-backdrop" id="delete-modal" hidden>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
        <div class="modal-accent modal-accent-danger"></div>
        <div class="modal-header">
            <h2 id="delete-modal-title">Delete customer</h2>
            <button type="button" class="modal-close" data-modal-cancel aria-label="Close">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
            </button>
        </div>
        <div class="modal-body">
            <div class="confirm">
                <div class="confirm-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01" /><path d="M10.3 3.9 2.4 18a2 2 0 0 0 1.7 3h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /></svg>
                </div>
                <div class="confirm-content">
                    <p class="confirm-message">Are you sure you want to delete <strong data-modal-name></strong>?</p>
                    <div class="confirm-warning"><strong>The customer will be removed from the list</strong> and can no longer be edited. You can undo this straight after deleting.</div>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn-secondary" data-modal-cancel>Cancel</button>
                <button type="button" class="btn-danger" data-modal-confirm>Delete customer</button>
            </div>
        </div>
    </div>
</div>
