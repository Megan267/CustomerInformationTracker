@model CustomerListViewModel
@{
    var query = Model.Query;
    var result = Model.Result;

    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var columns = new (string Label, string Css, CustomerSortField Field)[]
    {
        ("Name", "col-name", CustomerSortField.Name),
        ("Address", "col-address", CustomerSortField.City),
        ("Telephone", "col-phone", CustomerSortField.TelephoneNumber),
        ("Contact person", "col-contact", CustomerSortField.ContactPersonName),
        ("Contact email", "col-email", CustomerSortField.ContactPersonEmail),
        ("VAT number", "col-vat", CustomerSortField.VatNumber)
    };

    string SortUrl(CustomerSortField field)
    {
        bool desc = query.Sort == field && !query.Desc;
        return Url.Action("Index", new { name = query.Name, vat = query.Vat, status = query.StatusRouteValue, sort = field, desc = desc ? "true" : null }) ?? "#";
    }

    string PageUrl(int page)
    {
        return Url.Action("Index", new
        {
            name = query.Name,
            vat = query.Vat,
            status = query.StatusRouteValue,
            sort = query.Sort,
            desc = query.Desc ? "true" : null,
            page = page > 1 ? page : (int?)null
        }) ?? "#";
    }

    // Page numbers to show: first, last, and one either side of the current page. 0 = gap.
    var pages = new List<int>();
    for (int p = 1; p <= result.TotalPages; p++)
    {
        if (p == 1 || p == result.TotalPages || Math.Abs(p - result.Page) <= 1)
        {
            if (pages.Count > 0 && p - pages[^1] > 1)
            {
                pages.Add(0);
            }
            pages.Add(p);
        }
    }

    int firstShown = result.TotalCount == 0 ? 0 : (result.Page - 1) * result.PageSize + 1;
    int lastShown = Math.Min(result.Page * result.PageSize, result.TotalCount);
}

<div id="customer-results" data-count-text="@Model.CountText">
    <div class="table-scroll">
        <table class="data-table">
            <colgroup>
                @foreach (var col in columns)
                {
                    <col class="@col.Css" />
                }
                <col class="col-actions" />
            </colgroup>
            <thead>
                <tr>
                    @foreach (var col in columns)
                    {
                        bool sorted = query.Sort == col.Field;
                        <th scope="col" aria-sort="@(sorted ? (query.Desc ? "descending" : "ascending") : "none")">
                            <a class="sort-link @(sorted ? "is-sorted" : "")" href="@SortUrl(col.Field)"
                               title="@(col.Field == CustomerSortField.City ? "Sort by city" : "Sort by " + col.Label.ToLower())">
                                @col.Label
                                <span class="sort-arrow" aria-hidden="true">@(sorted && query.Desc ? "▼" : "▲")</span>
                            </a>
                        </th>
                    }
                    <th scope="col" class="actions-cell"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @if (result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="@(columns.Length + 1)" class="empty-state">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                            @if (query.HasSearch)
                            {
                                <text>No customers match those filters.</text>
                            }
                            else if (query.Status == CustomerStatusFilter.Inactive)
                            {
                                <text>No inactive customers. Deleted customers will show up here.</text>
                            }
                            else
                            {
                                <text>No customers yet. Use <strong>Add customer</strong> to capture the first one.</text>
                            }
                        </td>
                    </tr>
                }

                @foreach (var c in result.Items)
                {
                    var a = c.Address;
                    var cityLine = a == null
                        ? null
                        : string.Join(", ", new[] { a.City, a.Province, a.PostalCode, a.Country }.Where(s => !string.IsNullOrWhiteSpace(s)));

                    <tr class="@(c.IsActive ? null : "is-inactive")">
                        <td class="cell-wrap">
                            <span class="cell-name">@c.Name</span>
                            @if (!c.IsActive)
                            {
                                <span class="status-tag">Inactive</span>
                            }
                            <span class="cell-sub">Added @c.CreatedAt.ToString("d MMM yyyy")</span>
                        </td>
                        <td class="cell-wrap">
                            @if (a == null)
                            {
                                <span class="cell-empty">None</span>
                            }
                            else
                            {
                                <text>@a.Street</text>
                                <span class="cell-sub">@cityLine</span>
                            }
                        </td>
                        <td class="cell-nowrap">
                            @if (string.IsNullOrWhiteSpace(c.TelephoneNumber))
                            {
                                <span class="cell-empty">None</span>
                            }
                            else
                            {
                                <a class="cell-link" href="tel:@c.TelephoneNumber.Replace(" ", "")">@c.TelephoneNumber</a>
                            }
                        </td>
                        <td class="cell-wrap">
                            @if (string.IsNullOrWhiteSpace(c.ContactPersonName))
                            {
                                <span class="cell-empty">None</span>
                            }
                            else
                            {
                                <text>@c.ContactPersonName</text>
                            }
                        </td>
                        <td class="cell-ellipsis">
                            @if (string.IsNullOrWhiteSpace(c.ContactPersonEmail))
                            {
                                <span class="cell-empty">None</span>
                            }
                            else
                            {
                                <a class="cell-link" href="mailto:@c.ContactPersonEmail">@c.ContactPersonEmail</a>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(c.VatNumber))
                            {
                                <span class="cell-empty">None</span>
                            }
                            else
                            {
                                <span class="vat-tag">@c.VatNumber</span>
                            }
                        </td>
                        <td class="actions-cell">
                            @if (!c.IsActive)
                            {
                                <form method="post" asp-action="Reinstate" asp-route-id="@c.CustomerId" class="inline-form">
                                    <input type="hidden" name="customerName" value="@c.Name" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="icon-btn icon-btn-restore" title="Reinstate @c.Name">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
                                        Reinstate
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a class="icon-btn" asp-action="Manage" asp-route-id="@c.CustomerId" asp-route-returnUrl="@returnUrl" data-return-link
                                   title="Edit @c.Name">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                                    Edit
                                </a>
                                <form method="post" asp-action="Delete" asp-route-id="@c.CustomerId" class="inline-form"
                                      data-confirm-delete data-customer-name="@c.Name">
                                    <input type="hidden" name="customerName" value="@c.Name" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="icon-btn icon-btn-warn" title="Delete @c.Name">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /></svg>
                                        Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (result.TotalCount > 0)
    {
        <div class="pagination">
            <span>Showing @firstShown to @lastShown of @result.TotalCount</span>

            @if (result.TotalPages > 1)
            {
                <nav class="pager" aria-label="Pages">
                    <a class="pager-btn @(result.Page <= 1 ? "is-disabled" : "")" href="@PageUrl(result.Page - 1)"
                       aria-label="Previous page" aria-disabled="@(result.Page <= 1 ? "true" : null)">‹</a>

                    @foreach (var p in pages)
                    {
                        if (p == 0)
                        {
                            <span class="pager-gap">…</span>
                        }
                        else if (p == result.Page)
                        {
                            <span class="pager-btn is-current" aria-current="page">@p</span>
                        }
                        else
                        {
                            <a class="pager-btn" href="@PageUrl(p)">@p</a>
                        }
                    }

                    <a class="pager-btn @(result.Page >= result.TotalPages ? "is-disabled" : "")" href="@PageUrl(result.Page + 1)"
                       aria-label="Next page" aria-disabled="@(result.Page >= result.TotalPages ? "true" : null)">›</a>
                </nav>
            }
        </div>
    }
</div>
